/* ===== ORIGINAL STYLE RESTORED ===== */

body {
  margin: 0;
  background-color: #b9d0b8; /* your original green */
  font-family: 'Space Grotesk', sans-serif;
  color: #111;

  /* IMPORTANT: this is what keeps content away from sidebar */
  margin-left: 180px;
}

/* ===== LINKS ===== */

a {
  color: inherit;
  text-decoration: underline;
}

a:hover {
  color: #FF5DA2;
}

/* ===== TEXT ===== */

.section {
  padding: 60px 8vw;
  max-width: 600px;
}

.section p {
  font-size: 1.2rem;
  line-height: 1.6;
}

/* ===== IMAGES ===== */

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* banner images (music / skate / main) */
.banner {
  width: 90%;
  max-width: 500px;
  margin: 40px auto;
}

/* ===== VIDEO ===== */

.video-wrapper {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  margin: 20px 0 40px;
}

.video-wrapper iframe {
  position: absolute;
  width: 100%;
  height: 100%;
  border: none;
}

/* ===== MOBILE (iphone fix) ===== */

@media (max-width: 700px) {

  body {
    margin-left: 0; /* sidebar becomes top */
  }

  .section {
    padding: 20px;
    max-width: 100%;
  }

  h1 {
    font-size: 2.2rem;
  }

  h2 {
    font-size: 1.4rem;
  }

}
