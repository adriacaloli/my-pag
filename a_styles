body {
  margin: 0;
  margin-left: 130px; /* EXACT sidebar width */
  background-color: #b9d0b8;
  font-family: 'Space Grotesk', sans-serif;
  color: #111;
}

/* IMPORTANT: no shifting content anymore */
.content {
  padding: 0;
}

/* links */
a {
  color: inherit;
  text-decoration: underline;
}

a:hover {
  color: #FF5DA2;
}

/* text */
.section {
  padding: 60px 8vw;
  max-width: 650px;
}

.section p {
  font-size: 1.15rem;
  line-height: 1.6;
}

/* media */
img {
  max-width: 100%;
  display: block;
}

.video-wrapper {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  margin: 20px 0 40px;
}

.video-wrapper iframe {
  position: absolute;
  width: 80%;
  height: 80%;
  border: none;
}

/* mobile */
@media (max-width: 700px) {
  body {
    margin-left: 0;
  }

  .section {
    padding: 20px;
  }

  h1 { font-size: 2.2rem; }
  h2 { font-size: 1.4rem; }
}
