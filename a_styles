/* ===== GLOBAL STYLE ===== */

body {
  margin: 0;
  background-color: #d0e8d0;
  font-family: 'Space Grotesk', sans-serif;
  color: #111;
}

/* ===== LAYOUT ===== */

.content {
  margin-left: 180px;
  padding: 0;
}

/* MOBILE */
@media (max-width: 700px) {
  .content {
    margin-left: 0;
  }
}

/* ===== LINKS ===== */

a {
  color: inherit;
  text-decoration: underline;
  transition: color 0.2s ease;
}

a:hover {
  color: #FF5DA2;
}

/* ===== TEXT ===== */

.section {
  padding: 60px 8vw;
  max-width: 600px;
}

.section p {
  font-size: 1.2rem;
  line-height: 1.6;
}

/* ===== MEDIA ===== */

.banner {
  width: 90%;
  max-width: 500px;
}

.video-wrapper {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  margin: 20px 0 40px;
}

.video-wrapper iframe {
  position: absolute;
  width: 100%;
  height: 100%;
  border: none;
}

/* ===== MOBILE ===== */

@media (max-width: 700px) {

  .section {
    padding: 20px;
    max-width: 100%;
  }

  h1 { font-size: 2.2rem; }
  h2 { font-size: 1.4rem; }

}
