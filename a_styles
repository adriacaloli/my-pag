/* ===== GLOBAL ===== */

body {
  margin: 0;
  background-color: #d0e8d0;
  font-family: 'Space Grotesk', sans-serif;
  color: #111;
}

/* ===== SIDEBAR WIDTH (REAL VALUE) ===== */
/* your sidebar is ~130px + padding → we use 160 to be safe */

.content {
  margin-left: 160px;
  padding: 0;
}

/* MOBILE */
@media (max-width: 700px) {
  .content {
    margin-left: 0;
  }
}

/* ===== LINKS ===== */

a {
  color: inherit;
  text-decoration: underline;
  transition: color 0.2s ease;
}

a:hover {
  color: #FF5DA2;
}

/* ===== TEXT ===== */

.section {
  padding: 60px 8vw;
  max-width: 700px;
}

.section p {
  font-size: 1.1rem;
  line-height: 1.6;
}

/* ===== MEDIA ===== */

img {
  max-width: 100%;
  height: auto;
  display: block;
}

.banner {
  width: 100%;
  max-width: 700px;
  margin: 40px auto;
}

.video-wrapper {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  margin: 20px 0 40px;
}

.video-wrapper iframe {
  position: absolute;
  width: 100%;
  height: 100%;
  border: none;
}

/* ===== MOBILE ===== */

@media (max-width: 700px) {

  .section {
    padding: 20px;
  }

  h1 { font-size: 2.2rem; }
  h2 { font-size: 1.4rem; }

}
